#!/usr/bin/perl

$regex = shift @ARGV || die "Usage: rename <perl expression> <files>\n";

for my $file (@ARGV) {
	$_ = $file;
	eval $regex or die "invalid regex '$regex': $!\n";

	if ($_ ne $file) {
		rename $file, $_ and
			print STDOUT "rename($file, $_) :: ok\n" or
			print STDERR "rename($file, $_) :: error ($!)\n";
	}
}
